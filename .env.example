# ==========================================
# RoadReady Environment Configuration Template
# ==========================================

# ---------- Frontend (Vite, baked in at build time) ----------
# Public URL of the deployed API. REQUIRED for Vercel and for native (Capacitor) builds,
# e.g. https://roadready-api.onrender.com  (leave empty only for local dev with the Vite proxy)
VITE_API_BASE_URL=

# Accounts (Supabase Auth). Leave empty for guest-only mode.
# Supabase dashboard -> Project Settings -> API: Project URL and the publishable (or legacy anon) key.
# Both are safe to ship inside the app.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Where confirmation / password-reset emails send people back to (defaults to the current web origin)
VITE_AUTH_REDIRECT_URL=

# Payments in the mobile apps (RevenueCat public SDK keys, safe to ship). Web uses Stripe via the API.
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=
# Links shown on the paywall (required by the App Store for subscriptions)
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Optional Map Provider: Custom Mapbox Access Token (if empty, falls back to free CartoDB vector basemaps)
VITE_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=

# ---------- Backend (server/index.js) ----------
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# CORS allowed web origins (comma-separated). Required in production; Capacitor origins are always allowed.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_GLOBAL=300
RATE_LIMIT_MAX_WRITE=60

# Bearer token for the admin lead-export endpoint (unset = endpoint disabled)
ADMIN_TOKEN=
# Simulated checkout is DISABLED in production. Only set true for a staging/demo server.
ALLOW_SIMULATED_PAYMENTS=false

# ---------- Payments: web (Stripe) ----------
# SECRET. Use sk_test_... until you are ready to take real money.
STRIPE_SECRET_KEY=
# SECRET. Signing secret of the webhook endpoint https://<api>/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Price ids from the Stripe dashboard: a one-time price and a monthly recurring price
STRIPE_PRICE_LIFETIME=
STRIPE_PRICE_MONTHLY=
# Web app origin Stripe returns people to after checkout, e.g. https://roadready.app (required in production)
APP_URL=

# ---------- Payments: App Store / Google Play (RevenueCat) ----------
# SECRET. RevenueCat secret API key (sk_...), used to verify purchases server-side
REVENUECAT_SECRET_KEY=
# SECRET. Must equal the Authorization header value set on the RevenueCat webhook
REVENUECAT_WEBHOOK_AUTH=
# Entitlement that unlocks Pro (default: pro)
REVENUECAT_ENTITLEMENT_ID=pro

# ---------- Database ----------
# Postgres connection string. REQUIRED in production (the server refuses to start without it).
# Supabase: Project Settings -> Database -> Connection string (use the pooler URI, port 6543, on Render).
# Leave empty in development to use the embedded database stored in server/storage/pglite.
DATABASE_URL=
DATABASE_POOL_MAX=10
# Folder for the embedded development database (only used when DATABASE_URL is empty)
PGLITE_DIR=

# ---------- Accounts (server side) ----------
# Same project URL as VITE_SUPABASE_URL. Used to verify sign-in tokens.
SUPABASE_URL=
# SECRET: only needed if your project still signs tokens with the legacy JWT secret.
SUPABASE_JWT_SECRET=
# SECRET: service role / secret key, used ONLY to delete logins when a user deletes their account.
# Never put this in a VITE_ variable or ship it in the app.
SUPABASE_SERVICE_ROLE_KEY=
